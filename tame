def extract_title(md_path):
    with open(md_path, 'r') as f:
        title = f.readline().strip()

    if (title is None) or (not len(title)):
        return 'Unknown'

    if len(title):
        while title[0] in ('#', ' '):
            if len(title) > 1:
                title = title[1:]
            else:
                title = 'Unknown'

    return title


