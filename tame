# TODO: Assert path is inside of NOTES_DIRECTORY
def sanitize_path(path):
    NOT_ALLOWED = ('..', '~', '$', '//')
    for pattern in NOT_ALLOWED:
        if pattern in path:
            raise Exception(f'Illegal "{pattern}" in "{path}.')

    while path[0] == '/':
        path = path[1:]

    path_parts = path.split('/')

    return os.sep.join(path_parts)


