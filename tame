@main_bp.route("/load-note", methods=['GET'])
@login_required
def load_note():
    note_path = Path(os.path.join(
        NOTES_DIRECTORY,
        request.args.get('note')
    )).resolve()
    # TODO: sanitize note path

    if not note_path.is_file():
        return "Please select a note to view."

    with note_path.open('r') as fp:
        # Discard title line
        _ = fp.readline()

        # Load rest of note
        mdstuff = fp.read()

    # TODO: add tex
    if note_path.suffix == ".md":
        html_data = pypandoc.convert_text(
            mdstuff,
            'html5',
            format='md'
        )

    return html_data


